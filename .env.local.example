# Supabase – hämtas i Supabase Dashboard → Project Settings → API
# VIKTIGT: skapa projektet i regionen EU (Central / Frankfurt, eu-central-1).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role-nyckel (Project Settings → API). HEMLIG – endast server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (testläge) – https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook-signering: `stripe listen` (lokalt) eller dashboardens webhook (prod).
STRIPE_WEBHOOK_SECRET=whsec_...

# Publik bas-URL för Stripe-redirects (Checkout/Connect återvändning).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hemlighet för cron-routen (escrow-utbetalning). Vercel Cron skickar den som Bearer.
CRON_SECRET=valfri-lang-slumpstrang

# Mapbox – publik token för karta (mapbox.com → Tokens, börjar med pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
# Mapbox – anpassad kartstil från Mapbox Studio (studio.mapbox.com → Styles → Style URL)
# Lämna tom för att använda Mapbox standardstil (streets-v12)
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-username/your-style-id
